// LOCAL TESTING COPY ONLY — not wired into firebase.json for deploy.
// Mirrors what's asked to be pasted into the real rules in Firebase Console.
// Used to let the Firestore emulator actually enforce admin-only writes
// while testing the equipment/categories migration.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      // Admins can write anything; a signed-in user editing their own doc
      // (Profile page) may only touch name/photoURL — never role/factories.
      allow write: if isAdmin() || (
        isSignedIn() && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'photoURL'])
      );
    }
    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /equipment/{equipmentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /measures/{measureId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /catalog/{itemId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /history/{historyId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /reports/{reportId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /factories/{factoryId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /units/{unitId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
